<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="900.0" styleClass="root" stylesheets="@../styles/MainAppStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainAppController">

    <!-- 🔷 TOP -->
    <top>
        <VBox spacing="10" styleClass="top-container">

            <!-- Title -->
            <Label styleClass="title-label" text="📱 Phone Contact Manager">
                <font>
                    <Font name="Arial Black" size="24" />
                </font>
                <padding>
                    <Insets left="20" top="10" />
                </padding>
            </Label>

            <!-- Toolbar -->
            <HBox spacing="15" styleClass="toolbar">
                <padding>
                    <Insets bottom="10" left="20" right="20" top="10" />
                </padding>

                <Label styleClass="label" text="Group:" />
                <ComboBox fx:id="groupBy" onAction="#groupByHandle" styleClass="combo" />

                <Label styleClass="label" text="Sort:" />
                <ComboBox fx:id="sortBy" onAction="#sortByHandle" styleClass="combo" />

                <CheckBox fx:id="favorite" onAction="#favoriteHandle" styleClass="checkbox" text="⭐ Favorites Only" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="statistics" onAction="#statisticsHandle" styleClass="btn-primary" text="Statistics" />

                <Button fx:id="refresh" onAction="#refreshHandle" styleClass="btn-secondary" text="Refresh" />
            </HBox>

        </VBox>
    </top>

    <!-- 🔷 CENTER -->
    <center>
        <ListView fx:id="listView" styleClass="list-view-custom" />
    </center>

    <!-- 🔷 BOTTOM -->
    <bottom>
        <HBox styleClass="status-bar">
            <padding>
                <Insets bottom="8" left="20" right="20" top="8" />
            </padding>

            <Label styleClass="status-text" text="Ready" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="contactNumber" styleClass="status-muted" text="0 contacts" />
        </HBox>
    </bottom>

</BorderPane>
